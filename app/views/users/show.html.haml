.container.py-5
  %h1.mb-3= @user.name || @user.email
  - if @user.bio.present?
    %p= @user.bio
  - if @user.institution.present?
    %p.text-muted= @user.institution

  - if can? :edit, @user
    .mt-3
      = link_to "Edit Profile", edit_user_path(@user), class: "btn btn-outline-primary btn-sm"
      = link_to "Account Settings", edit_user_registration_path, class: "btn btn-outline-secondary btn-sm ms-1"
