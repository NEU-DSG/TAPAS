.container.py-5
  %h1.mb-3= @collection.title
  - if @collection.description.present?
    %p= @collection.description
  %p.text-muted
    Project:
    = link_to @collection.project.title, project_path(@collection.project)
  %span.badge{ class: @collection.is_public? ? "bg-success" : "bg-secondary" }
    = @collection.is_public? ? "Public" : "Private"

  .mt-3
    - if can? :update, @collection
      = link_to "Edit Collection", edit_collection_path(@collection), class: "btn btn-outline-primary btn-sm"
    - if user_signed_in? && can?(:create, CollectionCoreFile.new(collection: @collection))
      = link_to "Add File", new_core_file_path(collection_id: @collection.id), class: "btn btn-outline-primary btn-sm ms-1"

  %hr.my-4

  %section
    %h2.mb-3 Files
    - if @core_files.any?
      %ul.list-unstyled
        - @core_files.each do |core_file|
          %li.mb-3
            %h5= link_to core_file.title, core_file_path(core_file)
            - if core_file.description.present?
              %p= core_file.description
    - else
      %p.text-muted No files in this collection.

  - if can? :destroy, @collection
    %hr.my-4
    = button_to "Delete Collection", collection_path(@collection), method: :delete, class: "btn btn-outline-danger", form: { data: { turbo_confirm: "Delete this collection? This will permanently delete #{@core_files.count} file(s). This cannot be undone." } }
