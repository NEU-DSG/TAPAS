<h1>Project Invitation</h1>

<% if @invitation.usable? %>
  <p>You've been invited to join <strong><%= @project.title %></strong>.</p>
  <p>This invitation expires on <%= @invitation.expires_at.strftime("%B %-d, %Y") %>.</p>

  <%= button_to "Accept Invitation", accept_invitation_path(params[:token]), method: :post %>
<% elsif @invitation.revoked? %>
  <p>This invitation has been revoked.</p>
<% else %>
  <p>This invitation has expired.</p>
<% end %>
