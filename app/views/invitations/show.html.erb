<h1>Project Invitation</h1>

<% if @invitation.usable? %>
  <p>You've been invited to join <strong><%= @project.title %></strong>
  by <strong><%= @invitation.creator.name || @invitation.creator.email %></strong>.</p>
  <p>This invitation expires on <%= @invitation.expires_at.strftime("%B %-d, %Y") %>.</p>

  <% if user_signed_in? %>
    <%= button_to "Accept Invitation", accept_invitation_path(params[:token]), method: :post %>
  <% else %>
    <p>Sign in or create a TAPAS account to accept this invitation.</p>
    <%= link_to "Sign In", new_user_session_path, class: "btn btn-primary" %>
    <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-outline-primary" %>
  <% end %>
<% elsif @invitation.revoked? %>
  <p>This invitation has been revoked. Please contact the project owner if you believe this is a mistake.</p>
<% else %>
  <p>This invitation has expired. Please contact the project owner to request a new link.</p>
<% end %>
