<%# public: and private: stay typeable, but only Recent gets a button: the
    Public/Private buttons below already cover visibility. %>
<%= render "admin/base/index_header", title: "Projects", new_path: new_admin_project_path,
      filter_buttons: %i[recent] %>

<div class="filters">
  <div class="filter-group">
    <%= link_to "All Projects", admin_projects_path(clear_filters: true), class: "filter-btn-clear" %>
    <%= link_to "Public", admin_projects_path(visibility: "public"), class: class_names("filter-btn", active: session[:project_visibility] == "public") %>
    <%= link_to "Private", admin_projects_path(visibility: "private"), class: class_names("filter-btn", active: session[:project_visibility] == "private") %>
  </div>
</div>

<%= render "admin/base/index_table", resources: @projects,
      columns: %i[title depositor institution is_public created_at],
      sortable: %i[title institution is_public created_at] %>
