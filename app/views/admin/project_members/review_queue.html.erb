<%
# Lists pending project members who registered as brand-new TAPAS accounts via
# an invitation link and still need admin vetting before the owner is notified.
%>

<% content_for(:title) { "Admin Review Queue" } %>

<header class="main-content__header">
  <h1 class="main-content__page-title">
    <%= content_for(:title) %>
  </h1>
</header>

<section class="main-content__body">
  <% if @pending_members.empty? %>
    <p>No membership requests are awaiting admin review.</p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th>User</th>
          <th>Project</th>
          <th>Requested</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @pending_members.each do |member| %>
          <tr>
            <td><%= member.user.name || member.user.email %></td>
            <td><%= link_to member.project.title, [:admin, member.project] %></td>
            <td><%= member.created_at.to_fs(:long) %></td>
            <td>
              <%= button_to(
                "Approve",
                approve_admin_project_member_path(member),
                method: :patch,
                class: "button",
                form: { data: { turbo_confirm: "Approve #{member.user.name || member.user.email} and notify the project owner?" } }
              ) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
