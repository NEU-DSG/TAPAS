<%# Core file show page, with TAPAS-XQ processing retry. %>
<% if @core_file.processing_failed? %>
  <% content_for(:header_actions) do %>
    <%= button_to(
      "Retry Processing",
      retry_processing_admin_core_file_path(@core_file),
      method: :post,
      class: "button",
      style: "background-color: #f39c12; display: inline-block;",
      form: { class: "d-inline", data: { turbo_confirm: "Re-submit this file to TAPAS-XQ?" } }
    ) %>
  <% end %>
<% end %>

<%= render "admin/base/show_header", resource: @core_file %>

<%= render "admin/base/show_attributes", resource: @core_file, attributes: %i[
      id title description depositor collections ography_type tei_authors tei_contributors
      is_public image_file created_at updated_at
    ] %>

<% if @core_file.processing_failed? && @core_file.processing_error.present? %>
  <section class="main-content__body" style="margin-top: 2rem;">
    <div style="background-color: #fee; border: 1px solid #fcc; padding: 1rem; border-radius: 4px;">
      <h3 style="color: #c00; margin-top: 0;">Processing Error</h3>
      <pre style="white-space: pre-wrap; font-family: monospace; background-color: white; padding: 0.5rem; border-radius: 3px;"><%= @core_file.processing_error %></pre>
    </div>
  </section>
<% end %>
