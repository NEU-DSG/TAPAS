<%#
# Admin sidebar navigation.

Image files, view packages, project members and collection core files are
deliberately left out; they're reachable by URL and from the records they
belong to.
%>

<nav class="navigation">
  <div class="p-3 border-bottom">
    <h5 class="text-white mb-0">TAPAS Admin</h5>
  </div>

  <%= link_to(root_url, class: "navigation__link") do %>
    <span class="navigation__link__text">← Back to App</span>
  <% end %>

  <div class="mt-3"></div>

  <%# Highlighted by section (controller), not exact URL, so a record's view and
      edit pages and /admin itself keep their section lit. The review queue is
      a users action but has its own link, so it doesn't light up Users. %>
  <% review_queue = controller_name == "users" && action_name == "review_queue" %>
  <%= link_to("New Account Review", review_queue_admin_users_path,
        class: class_names("navigation__link", "navigation__link--active" => review_queue)) %>
  <%= link_to("Invitation Links", admin_project_invitations_path,
        class: class_names("navigation__link", "navigation__link--active" => controller_name == "project_invitations")) %>

  <div class="mt-3"></div>

  <% { "Collections" => [ admin_collections_path, "collections" ],
       "Core Files" => [ admin_core_files_path, "core_files" ],
       "Projects" => [ admin_projects_path, "projects" ],
       "Users" => [ admin_users_path, "users" ] }.each do |label, (path, section)| %>
    <%= link_to(path, class: class_names("navigation__link", "navigation__link--active" => controller_name == section && !review_queue)) do %>
      <span class="navigation__link__text"><%= label %></span>
    <% end %>
  <% end %>
</nav>
