<%= tag.li class: class_names("page-item", disabled: current_page.first?) do %>
  <% if current_page.first? %>
    <span class="page-link"><%= t("views.pagination.previous").html_safe %></span>
  <% else %>
    <%= link_to t("views.pagination.previous").html_safe, url, rel: "prev", class: "page-link" %>
  <% end %>
<% end %>
