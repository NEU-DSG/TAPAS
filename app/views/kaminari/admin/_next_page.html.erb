<%= tag.li class: class_names("page-item", disabled: current_page.last?) do %>
  <% if current_page.last? %>
    <span class="page-link"><%= t("views.pagination.next").html_safe %></span>
  <% else %>
    <%= link_to t("views.pagination.next").html_safe, url, rel: "next", class: "page-link" %>
  <% end %>
<% end %>
